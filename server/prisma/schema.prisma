// Schema inicial — punto de partida, ajustar campos según necesidad real

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_stat_statements, pgcrypto, uuid_ossp(map: "uuid-ossp"), supabase_vault]
}

generator postgis {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  markers   Marker[]
  comments  Comment[]
  createdAt DateTime   @default(now())
}

model Marker {
  id          String     @id @default(cuid())
  title       String
  description String?
  latitude    Float
  longitude   Float
  owner       User       @relation(fields: [ownerId], references: [id])
  ownerId     String
  comments    Comment[]
  createdAt   DateTime   @default(now())

  @@index([latitude, longitude])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  rating    Int      // 1-5
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  marker    Marker   @relation(fields: [markerId], references: [id])
  markerId  String
  createdAt DateTime @default(now())
}
